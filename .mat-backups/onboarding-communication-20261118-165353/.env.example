NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — required for lead storage and the private admin dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Used only by scripts/set-admin-role.mjs after you create the admin user in Supabase Auth.
ADMIN_EMAIL=

# Resend — transactional lead notifications.
# Verify myacademictutor.com in Resend before using your own From address in production.
RESEND_API_KEY=
MAT_EMAIL_FROM="My Academic Tutor <notifications@myacademictutor.com>"
MAT_LEADS_TO_EMAIL=Contact@myacademictutor.com
MAT_REPLY_TO_EMAIL=Contact@myacademictutor.com
